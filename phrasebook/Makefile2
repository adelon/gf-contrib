# Use 'make -j' to compile everything in parallel.
# Use e.g. 'make -j4' to compile at most 4 things in parallel.
RGL_DIR ?= ../../gf-rgl
export GF RGL_DIR
compile = BUILD_DIR=. sh ./build.sh

languages = Fre Ger Fin Eng Bul Cat Chi Cze Dan Dut Hin Ita Jpn Lav Nor Pes Pol Ron Rus Snd Spa Swe Tha Urd
modules = $(addprefix Phrasebook,$(languages)) DisambPhrasebookEng
pgfs = $(addsuffix .pgf,$(modules))

.PHONY: all FORCE
all: Phrasebook.pgf

Phrasebook.pgf: $(pgfs)
	$(compile) -link $(modules)

# Always let GF check source/RGL freshness, including transitive dependencies.
# Separate module output directories keep parallel compilation independent.
$(pgfs): %.pgf: FORCE
	$(compile) $*

FORCE:
